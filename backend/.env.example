# API Keys
GROQ_API_KEY=your_groq_api_key_here
expense_tracker_api_key=your_groq_api_key_here

# JWT
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Chatbot
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.5
MAX_TOKENS=500
CHAT_HISTORY_LIMIT=10

# Uploads
UPLOAD_FOLDER=uploads/receipts/

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=expense_tracker
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Google OAuth - created in Google Cloud Console
# https://console.cloud.google.com/apis/credentials
# Web client ID + Android client ID for the Flutter app.
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# SMTP - use Gmail + an App Password so the backend can send reset emails.
# How to create an App Password:
#   1. Enable 2-Step Verification on your Gmail account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password (16 chars, e.g. "abcd efgh ijkl mnop").
#   4. Put your Gmail address in SMTP_USER and the 16-char password (no spaces)
#      in SMTP_PASSWORD. Keep SMTP_FROM set to the same Gmail address.
#   5. Test with: python test_smtp.py your@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_email@gmail.com
